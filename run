#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

CMD="${1:-help}"
shift || true

case "$CMD" in
    server)
        # Use Go server if binary exists, otherwise fall back to Python
        if [ -f "$SCRIPT_DIR/arbiter-go" ]; then
            exec "$SCRIPT_DIR/arbiter-go" "$@"
        else
            exec python -m arbiter.server "$@"
        fi
        ;;
    server-python)
        exec python -m arbiter.server "$@"
        ;;
    build)
        export PATH="$PATH:/usr/local/go/bin"
        exec go build -o "$SCRIPT_DIR/arbiter-go" ./cmd/arbiter/
        ;;
    check)
        # Impact-selected gate. A Python-only diff does not run the Go suite:
        # on 2026-10-01 that suite cold-downloaded modules three times in
        # parallel and the check stage took 113s of a 188.8s release. Unknown
        # paths fail closed to every leg. SSH forwards localhost:11434 and
        # :11435 must be up when the Go leg runs (TestRemote* uses them).
        export PATH="$PATH:/usr/local/go/bin"
        if ! impact="$(python3 "$SCRIPT_DIR/scripts/check_impact.py")"; then
            echo "check impact selection failed; running the full suite" >&2
            impact=$'go\npython\ngpu-idle'
        fi
        if [ -z "$impact" ]; then
            echo "check impact: none (diff cannot affect tested behavior)"
            exit 0
        fi
        echo "check impact: $(printf '%s' "$impact" | tr '\n' ' ')"

        has_leg() {
            printf '%s\n' "$impact" | grep -qx "$1"
        }

        py_status=0
        go_status=0
        bg_pids=()
        cleanup_bg() {
            local pid
            for pid in ${bg_pids[@]+"${bg_pids[@]}"}; do
                kill "$pid" 2>/dev/null || true
            done
        }
        trap cleanup_bg EXIT

        if has_leg gpu-idle; then
            python3 -m unittest scripts/test_gpu_idle_hook.py &
            bg_pids+=($!)
            py_unittest_pid=$!
        fi
        # PYTHONPATH=src is mandatory: `arbiter` is installed in develop mode
        # pointing at the CANONICAL checkout, so without it a worktree gate
        # would silently test the canonical sources. tests/integration is
        # excluded on purpose — it drives the live spark fleet.
        if has_leg python; then
            PYTHONPATH="$SCRIPT_DIR/src" python3 -m pytest tests/unit src/arbiter/schemas_test.py src/arbiter/adapters/nimble_score_test.py src/arbiter/adapters/clef_score_test.py src/arbiter/adapters/mini_agi_test.py -q -n 4 &
            bg_pids+=($!)
            py_pytest_pid=$!
        fi
        if has_leg go; then
            unformatted="$(gofmt -l .)"
            if [ -n "$unformatted" ]; then
                echo "Unformatted Go files:" >&2
                echo "$unformatted" >&2
                exit 1
            fi
            # One download, then parallel build/vet/test. Three cold `go`
            # processes each printed `go: downloading` and held the module
            # lock (measured 2026-10-01: check 113s; warm parallel leg 18s).
            go mod download
            go build -o /dev/null ./cmd/arbiter/ &
            bg_pids+=($!)
            go_build_pid=$!
            go vet ./cmd/arbiter/ &
            bg_pids+=($!)
            go_vet_pid=$!
            if [ -n "${ARBITER_GO_TEST_SKIP:-}" ]; then
                go test ./cmd/arbiter/ -count=1 -p 1 -skip "$ARBITER_GO_TEST_SKIP" || go_status=$?
            else
                go test ./cmd/arbiter/ -count=1 -p 1 || go_status=$?
            fi
            wait "$go_build_pid" || go_status=$?
            wait "$go_vet_pid" || go_status=$?
        fi
        if [ -n "${py_unittest_pid:-}" ]; then
            wait "$py_unittest_pid" || py_status=$?
        fi
        if [ -n "${py_pytest_pid:-}" ]; then
            wait "$py_pytest_pid" || py_status=$?
        fi
        trap - EXIT
        if [ "$py_status" -ne 0 ]; then
            echo "Python test suite failed (see output above)" >&2
            exit "$py_status"
        fi
        exit "$go_status"
        ;;
    check-impact)
        exec python3 "$SCRIPT_DIR/scripts/check_impact.py" "$@"
        ;;
    deploy)
        # greenline deploy: drain-gated redeploy to spark. NEVER DEPLOY_FORCE=1.
        # Do NOT override DEPLOY_DRAIN_TIMEOUT here. This runs inside a greenline
        # release with a hard 600s end-to-end deadline; the old 9000s override
        # made every deploy during a long denoise wait ~2.5h for a drain that
        # could never finish in time, so the release was SIGTERM-killed mid-deploy
        # (2026-09-14: left arbiter draining and wedged the whole fleet). The
        # script's own bounded default applies; in-flight jobs are requeued by
        # the shutdown path, not lost.
        export PATH="$PATH:/usr/local/go/bin"
        exec ./deploy-to-spark.sh
        ;;
    test)
        exec python -m pytest tests/ "$@"
        ;;
    test-all)
        exec python -m pytest tests/ -m "not calibration" "$@"
        ;;
    adapter-test)
        exec python -m arbiter.adapter_test "$@"
        ;;
    calibrate)
        exec python -m arbiter.calibrate "$@"
        ;;
    ps)
        exec python -m arbiter.cli ps "$@"
        ;;
    jobs)
        exec python -m arbiter.cli jobs "$@"
        ;;
    submit)
        exec python -m arbiter.cli submit "$@"
        ;;
    cancel)
        exec python -m arbiter.cli cancel "$@"
        ;;
    health)
        exec python -m arbiter.cli health "$@"
        ;;
    help|--help|-h)
        cat <<'HELP'
Arbiter - Unified GPU Model Serving Platform

Usage: ./run <command> [args...]

Commands:
  server              Start the Arbiter API server
  build               Build the Arbiter Go server
  check               Run impact-selected tests (full suite if the diff is unknown)
  check-impact        Print the check legs the current diff selects
  deploy              Drain-gated deploy to spark
  test                Run fast tests (unit + integration, no calibration)
  test-all            Run all tests except calibration
  adapter-test <model> Test an adapter lifecycle (load/infer/verify/unload)
  calibrate <model>   Run calibration for a model (or --all for all models)
  ps                  Show loaded models and VRAM usage
  jobs                List job queue
  submit <type> ...   Submit an inference job
  cancel <job_id>     Cancel a job
  health              Check server health
  help                Show this help
HELP
        ;;
    *)
        echo "Unknown command: $CMD (try: ./run help)" >&2
        exit 1
        ;;
esac
