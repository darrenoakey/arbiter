+def sample_temporal_attention_strengths(
+    strengths: torch.Tensor,
+    positions: torch.Tensor,
+    num_video_tokens: int,
+) -> torch.Tensor:
+    """Interpolate decoded-frame strengths at the actual generated-token times."""
+    if strengths.ndim not in (1, 2) or strengths.shape[-1] < 2:
+        raise ValueError(f"strengths must have shape (N,) or (B, N), got {tuple(strengths.shape)}")
+    if positions.ndim not in (3, 4) or positions.shape[1] < 1:
+        raise ValueError(f"positions must have shape (B, axes, T[, bounds]), got {tuple(positions.shape)}")
+    if num_video_tokens < 1 or num_video_tokens > positions.shape[2]:
+        raise ValueError(f"num_video_tokens must be in [1, {positions.shape[2]}], got {num_video_tokens}")
+
+    times = positions[:, 0, :num_video_tokens].to(torch.float32)
+    if times.ndim == 3:
+        times = times.mean(dim=-1)
+    first = times.amin(dim=1, keepdim=True)
+    span = times.amax(dim=1, keepdim=True) - first
+    if torch.any(span <= 0):
+        raise ValueError("generated-video query temporal layout has no positive span")
+
+    values = strengths.to(device=positions.device, dtype=torch.float32)
+    if values.ndim == 1:
+        values = values.unsqueeze(0)
+    if values.shape[0] not in (1, times.shape[0]):
+        raise ValueError(f"strength batch must be 1 or {times.shape[0]}, got {values.shape[0]}")
+    values = values.expand(times.shape[0], -1)
+    coordinates = (times - first) * (values.shape[1] - 1) / span
+    lower = coordinates.floor().to(torch.long).clamp(max=values.shape[1] - 1)
+    upper = (lower + 1).clamp(max=values.shape[1] - 1)
+    fraction = coordinates - lower
+    return values.gather(1, lower) * (1.0 - fraction) + values.gather(1, upper) * fraction
+
+
+def build_temporal_attention_bias(
+    latent_state: LatentState,
+    strengths: torch.Tensor,
+    num_video_tokens: int,
+    key_start: int,
+    key_end: int,
+    query_chunk_size: int = 256,
+) -> TemporalAttentionBias:
+    """Build compact log weights without allocating a token-square tensor."""
+    from ltx_core.types import TemporalAttentionBias
+
+    if key_start < num_video_tokens or key_end <= key_start or key_end > latent_state.latent.shape[1]:
+        raise ValueError(
+            f"endpoint guide key range [{key_start}, {key_end}) is invalid for "
+            f"{num_video_tokens} generated and {latent_state.latent.shape[1]} total tokens"
+        )
+    if query_chunk_size < 1:
+        raise ValueError(f"query_chunk_size must be positive, got {query_chunk_size}")
+    sampled = sample_temporal_attention_strengths(strengths, latent_state.positions, num_video_tokens)
+    if not torch.all(torch.isfinite(sampled)) or torch.any((sampled < 0) | (sampled > 1)):
+        raise ValueError("sampled temporal attention strengths must be finite and in [0, 1]")
+    finfo = torch.finfo(latent_state.latent.dtype)
+    log_weights = torch.full_like(sampled, finfo.min, dtype=latent_state.latent.dtype)
+    positive = sampled > 0
+    log_weights[positive] = torch.log(sampled[positive].clamp(min=finfo.tiny)).to(latent_state.latent.dtype)
+    return TemporalAttentionBias(log_weights, key_start, key_end, query_chunk_size)
