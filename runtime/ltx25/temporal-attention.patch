+def _slice_attention_mask(mask: torch.Tensor | None, start: int, end: int) -> torch.Tensor | None:
+    if mask is None:
+        return None
+    query_axis = -2
+    if mask.shape[query_axis] == 1:
+        return mask
+    return mask[..., start:end, :]
+
+
+def temporal_attention(
+    attention_function: MaskedAttentionCallable,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    heads: int,
+    mask: torch.Tensor | None,
+    temporal_bias: TemporalAttentionBias,
+) -> torch.Tensor:
+    """Apply compact endpoint guidance in bounded query chunks."""
+    batch, query_count, _ = q.shape
+    if temporal_bias.query_log_weights.shape[0] not in (1, batch):
+        raise ValueError(
+            f"temporal bias batch must be 1 or {batch}, got {temporal_bias.query_log_weights.shape[0]}"
+        )
+    if temporal_bias.query_log_weights.shape[1] > query_count:
+        raise ValueError("temporal bias has more generated queries than the attention input")
+    if not 0 <= temporal_bias.key_start < temporal_bias.key_end <= k.shape[1]:
+        raise ValueError("temporal endpoint-guide key range is outside the attention input")
+
+    outputs = []
+    query_weights = temporal_bias.query_log_weights.to(device=q.device, dtype=q.dtype).expand(batch, -1)
+    finfo = torch.finfo(q.dtype)
+    for start in range(0, query_count, temporal_bias.query_chunk_size):
+        end = min(start + temporal_bias.query_chunk_size, query_count)
+        chunk_mask = _slice_attention_mask(mask, start, end)
+        if chunk_mask is None:
+            chunk_mask = torch.zeros(
+                (batch, 1, end - start, k.shape[1]),
+                device=q.device,
+                dtype=q.dtype,
+            )
+        else:
+            chunk_mask = chunk_mask.expand(batch, 1, end - start, k.shape[1]).clone()
+
+        guided_end = min(end, query_weights.shape[1])
+        if start < guided_end:
+            weights = query_weights[:, start:guided_end, None]
+            target = chunk_mask[:, :, : guided_end - start, temporal_bias.key_start : temporal_bias.key_end]
+            positive = weights > finfo.min
+            target.copy_(torch.where(positive[:, None], target + weights[:, None], finfo.min))
+        outputs.append(attention_function(q[:, start:end], k, v, heads, chunk_mask))
+    return torch.cat(outputs, dim=1)
