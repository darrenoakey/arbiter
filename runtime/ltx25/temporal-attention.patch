+def temporal_attention_capability() -> dict[str, object]:
+    """Report the executable contract consumed by the Arbiter adapters."""
+    return {
+        "version": TEMPORAL_ATTENTION_CAPABILITY_VERSION,
+        "both_stages": True,
+        "asymmetric_video_query_to_endpoint_key": True,
+        "query_chunk_size": 256,
+    }
+
+
+def _validate_attention_strengths(value: object, num_frames: int) -> torch.Tensor | None:
+    if value is None:
+        return None
+    if not isinstance(value, list) or len(value) != num_frames:
+        raise ValueError(
+            f"{END_IMAGE_ATTENTION_STRENGTHS} must contain exactly {num_frames} expanded values"
+        )
+    strengths = torch.tensor(value, dtype=torch.float32)
+    if not torch.all(torch.isfinite(strengths)) or torch.any((strengths < 0) | (strengths > 1)):
+        raise ValueError(f"{END_IMAGE_ATTENTION_STRENGTHS} values must be finite and in [0, 1]")
+    return strengths
+
+
+def _apply_endpoint_attention_strengths(
+    conditionings: list,
+    strengths: torch.Tensor | None,
+    num_frames: int,
+) -> list:
+    if strengths is None:
+        return conditionings
+    endpoint = num_frames - 1
+    matches = [index for index, item in enumerate(conditionings) if getattr(item, "frame_idx", None) == endpoint]
+    if len(matches) != 1:
+        raise ValueError(f"temporal attention requires exactly one endpoint conditioning at frame {endpoint}")
+    result = list(conditionings)
+    result[matches[0]] = ConditioningItemAttentionStrengthWrapper(
+        result[matches[0]],
+        video_query_attention_strengths=strengths,
+        query_chunk_size=256,
+    )
+    return result
