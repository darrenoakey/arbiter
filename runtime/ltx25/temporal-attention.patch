+def _capture_value_key(value: object) -> Hashable:
+    """Describe graph-relevant structure without keying on mutable tensor values."""
+    if isinstance(value, torch.Tensor):
+        return ("tensor", tuple(value.shape), str(value.dtype), str(value.device))
+    if dataclasses.is_dataclass(value) and not isinstance(value, type):
+        value_type = type(value)
+        return (
+            "dataclass",
+            value_type.__module__,
+            value_type.__qualname__,
+            tuple(
+                (field.name, _capture_value_key(getattr(value, field.name)))
+                for field in dataclasses.fields(value)
+            ),
+        )
+    if isinstance(value, tuple):
+        return ("tuple", tuple(_capture_value_key(item) for item in value))
+    if value is None:
+        return ("none",)
+    if isinstance(value, (bool, int, float, str)):
+        return (type(value).__name__, value)
+    value_type = type(value)
+    return ("object", value_type.__module__, value_type.__qualname__)
+
